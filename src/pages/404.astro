---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" noindex>
  <section class="section">
    <div class="wrap" style="display:grid;gap:1.5rem;justify-items:start;min-height:50vh;align-content:center">
      <p class="eyebrow">Error 404</p>
      <h1 class="display" style="font-size:var(--t-2xl);line-height:.95">Este espacio <em class="acc">aún no está construido.</em></h1>
      <p class="lead muted">La página que buscas no existe o cambió de lugar.</p>
      <div class="ctas">
        <a class="btn" href="/">Volver al inicio</a>
        <a class="btn btn--ghost" href="/proyectos/">Ver proyectos</a>
      </div>
    </div>
  </section>
</Base>
