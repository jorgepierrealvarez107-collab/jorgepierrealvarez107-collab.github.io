---
/**
 * Logotipo provisional (wordmark tipográfico). Sustituir por el logotipo
 * oficial en SVG cuando esté disponible.
 */
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
---
<span class:list={['logo', `logo--${size}`]}>
  <svg class="logo__mark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M2 22 12 2l10 20" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M6.5 13h11" stroke="var(--accent)" stroke-width="1.6" />
  </svg>
  <span class="logo__word">ALVRA</span>
  <span class="logo__sub">Studio</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    line-height: 1;
  }
  .logo__mark {
    width: 22px;
    height: 22px;
  }
  .logo__word {
    font-family: var(--f-body);
    font-weight: 600;
    font-variation-settings: 'wdth' 125;
    letter-spacing: 0.18em;
    font-size: 1rem;
  }
  .logo__sub {
    font-family: var(--f-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--graphite);
    padding-left: 0.55rem;
    border-left: 1px solid var(--line);
  }
  .logo--lg .logo__mark {
    width: 40px;
    height: 40px;
  }
  .logo--lg .logo__word {
    font-size: 1.75rem;
  }
</style>
