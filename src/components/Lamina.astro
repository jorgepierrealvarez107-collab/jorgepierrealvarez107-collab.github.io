---
/**
 * Lámina de demostración: dibuja un alzado como "trazo" (plano) o como
 * "obra" (materiales). Es un marcador de posición, nunca obra real.
 */
import { dibujos, SUELO, type Material } from '../lib/dibujos';

interface Props {
  dibujo: keyof typeof dibujos;
  modo: 'trazo' | 'obra';
  rotulo?: string;
}

const { dibujo, modo, rotulo = 'Lámina de demostración' } = Astro.props;
const d = dibujos[dibujo];
const uid = `l${Math.random().toString(36).slice(2, 8)}`;
const letras = 'ABCDEFGH';

const fills: Record<Material, string> = {
  concreto: '#B8B3A9',
  madera: '#9C7552',
  enlucido: '#ECE8E0',
  piedra: '#8C857A',
  metal: '#3F3F3C',
};

const minX = Math.min(...d.ejes);
const maxX = Math.max(...d.ejes);
const fmt = (n: number) => (n * 10).toLocaleString('es-MX').replace(/,/g, ' ');
---
{modo === 'trazo' ? (
  <svg class="lamina lamina--trazo" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${d.nombre}: dibujo de líneas (demostración)`}>
    <defs>
      <pattern id={`${uid}-grid`} width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-opacity=".07" stroke-width="1" />
      </pattern>
      <pattern id={`${uid}-hatch`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="14" stroke="currentColor" stroke-opacity=".45" stroke-width="1.2" />
      </pattern>
    </defs>
    <rect width="1600" height="1000" fill="var(--paper)" />
    <rect width="1600" height="1000" fill={`url(#${uid}-grid)`} style="color:var(--ink)" />

    <g class="lam-ink" fill="none" stroke="var(--ink)">
      {/* Ejes */}
      <g class="lam-ejes" stroke-width="1" stroke-dasharray="14 6 3 6" stroke-opacity=".55">
        {d.ejes.map((x) => <line class="dr" pathLength="1" x1={x} y1="128" x2={x} y2="880" />)}
      </g>
      <g class="lam-ejes-rot">
        {d.ejes.map((x, i) => (
          <g>
            <circle cx={x} cy="100" r="20" stroke-width="1.2" />
            <text x={x} y="107" text-anchor="middle" class="lam-txt" fill="var(--ink)" stroke="none">{letras[i]}</text>
          </g>
        ))}
      </g>

      {/* Terreno */}
      <rect x="0" y={SUELO} width="1600" height="26" fill={`url(#${uid}-hatch)`} stroke="none" style="color:var(--ink)" />
      <line class="dr" pathLength="1" x1="40" y1={SUELO} x2="1560" y2={SUELO} stroke-width="3" />

      {/* Volúmenes */}
      <g stroke-width="2.4">
        {d.vols.map((v) => <rect class="dr" pathLength="1" x={v.x} y={v.y} width={v.w} height={v.h} />)}
      </g>

      {/* Extras */}
      {d.extras?.map((e) =>
        e.tipo === 'losas' ? (
          <g stroke-width="1.4">
            {[1, 2].map((i) => <line class="dr" pathLength="1" x1={e.x} y1={e.y + i * (e.h ?? 140)} x2={e.x + (e.w ?? 0)} y2={e.y + i * (e.h ?? 140)} />)}
          </g>
        ) : e.tipo === 'andamio' ? (
          <g stroke-width="1" stroke-dasharray="6 6" stroke-opacity=".6">
            <rect class="dr" pathLength="1" x={e.x} y={e.y} width={e.w} height={e.h} />
          </g>
        ) : (
          <g stroke-width="1.2" stroke-dasharray="4 5">
            <circle class="dr" pathLength="1" cx={e.x} cy={e.y - (e.r ?? 100) * 1.7} r={e.r} />
            <line class="dr" pathLength="1" x1={e.x} y1={e.y} x2={e.x} y2={e.y - (e.r ?? 100) * 0.7} />
          </g>
        )
      )}

      {/* Huecos */}
      <g stroke-width="1.6">
        {d.huecos.map((h) => (
          <g>
            <rect class="dr" pathLength="1" x={h.x} y={h.y} width={h.w} height={h.h} />
            {h.tipo === 'puerta' ? (
              <line class="dr" pathLength="1" x1={h.x + h.w / 2} y1={h.y} x2={h.x + h.w / 2} y2={h.y + h.h} stroke-width="1" />
            ) : (
              <g stroke-width=".9" stroke-opacity=".6">
                <line class="dr" pathLength="1" x1={h.x + h.w * 0.15} y1={h.y + h.h} x2={h.x + h.w * 0.55} y2={h.y} />
                <line class="dr" pathLength="1" x1={h.x + h.w * 0.35} y1={h.y + h.h} x2={h.x + h.w * 0.75} y2={h.y} />
              </g>
            )}
          </g>
        ))}
      </g>

      {/* Cotas */}
      <g stroke-width="1" class="lam-cotas">
        <line class="dr" pathLength="1" x1={minX} y1="920" x2={maxX} y2="920" />
        {d.ejes.map((x) => <line x1={x - 8} y1="928" x2={x + 8} y2="912" stroke-width="1.6" />)}
        {d.ejes.slice(1).map((x, i) => (
          <text x={(x + d.ejes[i]) / 2} y="906" text-anchor="middle" class="lam-txt lam-txt--sm" fill="var(--ink)" stroke="none">{fmt(x - d.ejes[i])}</text>
        ))}
      </g>
    </g>

    {/* Cartela */}
    <g class="lam-cartela">
      <rect x="1180" y="938" width="390" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1" />
      <line x1="1300" y1="938" x2="1300" y2="982" stroke="var(--ink)" stroke-width="1" />
      <text x="1196" y="966" class="lam-txt lam-txt--sm" fill="var(--ink)">ALVRA</text>
      <text x="1316" y="966" class="lam-txt lam-txt--sm" fill="var(--accent)">{d.nombre.toUpperCase()} · DEMO</text>
    </g>
  </svg>
) : (
  <svg class="lamina lamina--obra" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${d.nombre}: representación de materiales (imagen de demostración, no es obra real)`}>
    <defs>
      <pattern id={`${uid}-madera`} width="22" height="40" patternUnits="userSpaceOnUse">
        <rect width="22" height="40" fill={fills.madera} />
        <line x1="21" y1="0" x2="21" y2="40" stroke="#6E4E33" stroke-width="2" />
      </pattern>
      <pattern id={`${uid}-piedra`} width="120" height="40" patternUnits="userSpaceOnUse">
        <rect width="120" height="40" fill={fills.piedra} />
        <path d="M0 39.5H120M70 0V40M10 20H120" stroke="#6F695F" stroke-width="1.5" fill="none" />
      </pattern>
      <pattern id={`${uid}-concreto`} width="120" height="70" patternUnits="userSpaceOnUse">
        <rect width="120" height="70" fill={fills.concreto} />
        <path d="M0 69.5H120M119.5 0V70" stroke="#9E998F" stroke-width="1" fill="none" />
        <circle cx="20" cy="17" r="2" fill="#99948A" /><circle cx="100" cy="17" r="2" fill="#99948A" />
        <circle cx="20" cy="52" r="2" fill="#99948A" /><circle cx="100" cy="52" r="2" fill="#99948A" />
      </pattern>
    </defs>

    {/* Cielo y terreno: planos de color, sin degradados */}
    <rect width="1600" height="1000" fill="#D9D4CA" />
    <rect y={SUELO} width="1600" height={1000 - SUELO} fill="#5F5B53" />
    <rect y={SUELO} width="1600" height="8" fill="#4A4740" />

    {d.extras?.filter((e) => e.tipo === 'arbol').map((e) => (
      <g>
        <rect x={e.x - 6} y={e.y - (e.r ?? 100) * 0.9} width="12" height={(e.r ?? 100) * 0.9} fill="#4E4436" />
        <circle cx={e.x} cy={e.y - (e.r ?? 100) * 1.7} r={e.r} fill="#6F755F" />
        <circle cx={e.x + (e.r ?? 100) * 0.35} cy={e.y - (e.r ?? 100) * 1.95} r={(e.r ?? 100) * 0.55} fill="#7E846C" />
      </g>
    ))}

    {/* Sombra proyectada al suelo */}
    {d.vols.filter((v) => v.y + v.h >= SUELO - 2).map((v) => (
      <rect x={v.x + 30} y={SUELO} width={v.w} height="20" fill="#000" fill-opacity=".22" />
    ))}

    {d.vols.map((v) => {
      const fill = v.mat === 'madera' || v.mat === 'piedra' || v.mat === 'concreto' ? `url(#${uid}-${v.mat})` : fills[v.mat];
      return (
        <g>
          <rect x={v.x} y={v.y} width={v.w} height={v.h} fill={fill} />
          <rect x={v.x} y={v.y + v.h - Math.min(14, v.h * 0.2)} width={v.w} height={Math.min(14, v.h * 0.2)} fill="#000" fill-opacity=".12" />
        </g>
      );
    })}

    {/* Sombra del voladizo sobre el basamento */}
    {dibujo === 'voladizo' && <rect x="440" y="620" width="560" height="46" fill="#000" fill-opacity=".2" />}
    {dibujo === 'pabellon' && <rect x="420" y="540" width="760" height="40" fill="#000" fill-opacity=".25" />}

    {d.extras?.filter((e) => e.tipo === 'losas').map((e) => (
      <g>{[0, 1, 2].map((i) => <rect x={e.x} y={e.y + i * (e.h ?? 140)} width={e.w} height="14" fill="#A8A398" />)}</g>
    ))}

    {d.huecos.map((h) =>
      h.tipo === 'puerta' ? (
        <rect x={h.x} y={h.y} width={h.w} height={h.h} fill="#3A342D" />
      ) : (
        <g>
          <rect x={h.x} y={h.y} width={h.w} height={h.h} fill="#2C3338" />
          <polygon points={`${h.x + h.w * 0.12},${h.y + h.h} ${h.x + h.w * 0.42},${h.y} ${h.x + h.w * 0.6},${h.y} ${h.x + h.w * 0.3},${h.y + h.h}`} fill="#fff" fill-opacity=".09" />
          <rect x={h.x} y={h.y} width={h.w} height="4" fill="#1D2226" />
        </g>
      )
    )}

    {d.extras?.filter((e) => e.tipo === 'andamio').map((e) => {
      const niveles = Math.floor((e.h ?? 600) / 120);
      return (
        <g stroke="#1F3FBF" stroke-opacity=".75" stroke-width="3" fill="none">
          <line x1={e.x + 20} y1={e.y} x2={e.x + 20} y2={e.y + (e.h ?? 0)} />
          <line x1={e.x + (e.w ?? 0)} y1={e.y} x2={e.x + (e.w ?? 0)} y2={e.y + (e.h ?? 0)} />
          {Array.from({ length: niveles + 1 }, (_, i) => (
            <line x1={e.x + 20} y1={e.y + i * 120} x2={e.x + (e.w ?? 0)} y2={e.y + i * 120} />
          ))}
          {Array.from({ length: niveles }, (_, i) => (
            <line x1={e.x + 20} y1={e.y + i * 120} x2={e.x + (e.w ?? 0)} y2={e.y + (i + 1) * 120} stroke-width="1.5" />
          ))}
        </g>
      );
    })}

    <g class="lam-aviso">
      <rect x="40" y="40" width="430" height="44" fill="#0A1430" fill-opacity=".82" />
      <text x="60" y="69" class="lam-txt lam-txt--sm" fill="#F3F3F0">{rotulo.toUpperCase()}</text>
    </g>
  </svg>
)}
