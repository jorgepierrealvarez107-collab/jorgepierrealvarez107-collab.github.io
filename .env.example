# Dominio público del sitio (sin barra final). Opcional hasta el lanzamiento.
SITE_URL=

# Endpoint que recibe las solicitudes del formulario (POST JSON).
# Compatible con Formspree (https://formspree.io/f/XXXX) o con una función
# serverless propia. No pongas aquí claves secretas: todo lo que empieza por
# PUBLIC_ es visible en el navegador.
PUBLIC_CONTACT_ENDPOINT=
